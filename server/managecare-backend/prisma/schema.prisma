generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model admin_email_logs {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subject           String
  body              String?
  recipients        Json      @default("[]")
  status            String    @default("processing")
  sent_count        Int       @default(0)
  failed_count      Int       @default(0)
  failed_recipients Json      @default("[]")
  sent_by           String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_admin_email_logs_created")
}

model admin_notifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type       String
  title      String
  message    String?
  data       Json?     @default("{}")
  is_read    Boolean?  @default(false)
  created_by String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model admin_settings {
  id         String    @id @default("admin_settings")
  settings   Json?     @default("{}")
  updated_by String?   @db.Uuid
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model admin_work_items {
  id                    String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                 String
  description           String
  assigned_to           String?
  type                  String              @default("fix")
  priority              String?             @default("normal")
  status                String?             @default("pending")
  due_date              DateTime?           @db.Timestamptz(6)
  created_by            String?             @db.Uuid
  updated_by            String?             @db.Uuid
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @default(now()) @db.Timestamptz(6)
  assigned_to_worker_id String?             @db.Uuid
  managecare_workers    managecare_workers? @relation(fields: [assigned_to_worker_id], references: [id], onUpdate: NoAction)

  @@index([assigned_to_worker_id, status], map: "idx_admin_work_items_assigned_worker")
  @@index([status, priority], map: "idx_admin_work_items_status")
}

model apartment_booking_payments {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String             @db.Uuid
  booking_id         String             @db.Uuid
  amount             Decimal            @db.Decimal(12, 2)
  currency           String             @default("NGN")
  provider           String?
  transaction_id     String?
  processor_response Json?              @default("{}")
  status             String             @default("completed")
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  apartment_bookings apartment_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses         businesses         @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "idx_apartment_booking_payments_booking_id")
  @@index([business_id], map: "idx_apartment_booking_payments_business_id")
}

model apartment_bookings {
  id                         String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id                String                       @db.Uuid
  unit_id                    String?                      @db.Uuid
  apartment_id               String?                      @db.Uuid
  tenant_id                  String?
  check_in_date              DateTime                     @db.Timestamptz(6)
  check_out_date             DateTime                     @db.Timestamptz(6)
  nights                     Int?                         @default(0)
  guests                     Int?                         @default(1)
  status                     String?                      @default("pending")
  subtotal                   Decimal?                     @default(0) @db.Decimal(12, 2)
  deposit_amount             Decimal?                     @default(0) @db.Decimal(12, 2)
  discount                   Decimal?                     @default(0) @db.Decimal(12, 2)
  total                      Decimal?                     @default(0) @db.Decimal(12, 2)
  currency                   String?                      @default("NGN")
  payment_status             String?                      @default("none")
  payment_method             String?
  provider_transaction_id    String?
  paid_at                    DateTime?                    @db.Timestamptz(6)
  policy_snapshot            Json?                        @default("{}")
  receipt_url                String?
  receipt_pdf_path           String?
  next_reminder_at           DateTime?                    @db.Timestamptz(6)
  reminder_sent_flags        Json?                        @default("{}")
  cancel_reason              String?
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  apartment_booking_payments apartment_booking_payments[]
  apartments                 apartments?                  @relation(fields: [apartment_id], references: [id], onUpdate: NoAction)
  businesses                 businesses                   @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apartment_units            apartment_units?             @relation(fields: [unit_id], references: [id], onUpdate: NoAction)

  @@index([business_id, created_at(sort: Desc)], map: "idx_apartment_bookings_business")
  @@index([unit_id, check_in_date, check_out_date, status], map: "idx_apartment_bookings_unit_dates")
}

model apartment_units {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String               @db.Uuid
  apartment_id       String               @db.Uuid
  name               String
  capacity           Int?                 @default(1)
  price_per_night    Decimal?             @default(0) @db.Decimal(12, 2)
  available_from     DateTime?            @db.Timestamptz(6)
  available_to       DateTime?            @db.Timestamptz(6)
  photos             Json?                @default("[]")
  active             Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  apartment_bookings apartment_bookings[]
  apartments         apartments           @relation(fields: [apartment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses         businesses           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, apartment_id, name], map: "idx_apartment_units_apartment")
}

model apartments {
  id                             String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id                    String               @db.Uuid
  title                          String
  description                    String?              @default("")
  owner_id                       String?              @db.Uuid
  address                        String?              @default("")
  photos                         Json?                @default("[]")
  amenities                      Json?                @default("[]")
  default_cancellation_policy_id String?
  created_at                     DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime?            @default(now()) @db.Timestamptz(6)
  apartment_bookings             apartment_bookings[]
  apartment_units                apartment_units[]
  businesses                     businesses           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, created_at(sort: Desc)], map: "idx_apartments_business")
}

model app_marketers {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String?
  email      String?
  phone      String?
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id                String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  worker_id         String?     @db.Uuid
  business_id       String?     @db.Uuid
  device_sn         String?
  user_id_on_device String?
  timestamp         DateTime    @default(now()) @db.Timestamptz(6)
  status            String?
  verify_mode       String?
  created_at        DateTime?   @default(now()) @db.Timestamptz(6)
  businesses        businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workers           workers?    @relation(fields: [worker_id], references: [id], onUpdate: NoAction)

  @@index([business_id], map: "idx_attendance_business")
  @@index([device_sn], map: "idx_attendance_device")
  @@index([timestamp(sort: Desc)], map: "idx_attendance_timestamp")
  @@index([worker_id], map: "idx_attendance_worker")
}

model bakery_resupplies {
  id                         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id                String     @db.Uuid
  inventory_id               String     @db.Uuid
  inventory_name             String?
  quantity                   Decimal    @default(0) @db.Decimal(12, 2)
  unit                       String?
  baker_id                   String?    @db.Uuid
  baker_name                 String?
  notes                      String?
  performed_by_id            String?    @db.Uuid
  performed_by_name          String?
  expected_production_amount Decimal    @default(0) @db.Decimal(12, 2)
  actual_production_amount   Decimal    @default(0) @db.Decimal(12, 2)
  production_unit            String?
  production_item_name       String?
  created_at                 DateTime   @default(now()) @db.Timestamptz(6)
  legacy_firestore_id        String?
  businesses                 businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory                  inventory  @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baker_id], map: "idx_bakery_resupplies_baker_id")
  @@index([business_id], map: "idx_bakery_resupplies_business_id")
  @@index([created_at(sort: Desc)], map: "idx_bakery_resupplies_created_at")
  @@index([legacy_firestore_id], map: "idx_bakery_resupplies_legacy_fs")
}

model bar_invoices {
  id             String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id    String     @db.Uuid
  invoice_number String
  invoice_type   String     @default("invoice")
  status         String     @default("open")
  customer_id    String?    @db.Uuid
  customer_name  String?
  customer_phone String?
  customer_email String?
  table_label    String?
  notes          String?
  lines          Json       @default("[]")
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  tax            Decimal    @default(0) @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @default(0) @db.Decimal(12, 2)
  converted_at   DateTime?  @db.Timestamptz(6)
  linked_sale_id String?    @db.Uuid
  payment_method String?
  worker_id      String?    @db.Uuid
  worker_name    String?
  store_id       String?    @db.Uuid
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  businesses     businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id], map: "idx_bar_invoices_business_id")
}

model bar_tables {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String     @db.Uuid
  label       String
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([business_id, label])
  @@index([business_id], map: "idx_bar_tables_business_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_members {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String     @db.Uuid
  business_id String     @db.Uuid
  role        String     @default("staff")
  store_id    String?    @db.Uuid
  is_owner    Boolean?   @default(false)
  is_active   Boolean?   @default(true)
  permissions Json?      @default("{}")
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles    profiles   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activities  Activity[]

  @@unique([user_id, business_id])
  @@index([business_id, is_active], map: "idx_business_members_active", where: raw("(is_active = true)"))
  @@index([business_id], map: "idx_business_members_business")
  @@index([user_id], map: "idx_business_members_user")
}

model businesses {
  id                                                     String                                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                                                   String                                @default("")
  business_type                                          String?
  owner_id                                               String?                               @db.Uuid
  created_at                                             DateTime?                             @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime?                             @default(now()) @db.Timestamptz(6)
  address                                                String?
  phone                                                  String?
  email                                                  String?
  owner_name                                             String?
  currency                                               String?                               @default("NGN")
  logo_url                                               String?
  store_ids                                              String[]                              @default([]) @db.Uuid
  is_active                                              Boolean?                              @default(true)
  last_sku_number                                        Int?                                  @default(0)
  business_class                                         String?                               @default("tier1")
  max_workers                                            Int?
  features                                               Json?                                 @default("{}")
  subscription_tier                                      String?                               @default("free")
  subscription_plan                                      String?                               @default("free")
  subscription_start_date                                DateTime?                             @db.Timestamptz(6)
  subscription_end_date                                  DateTime?                             @db.Timestamptz(6)
  is_subscription_active                                 Boolean?                              @default(false)
  is_restricted                                          Boolean?                              @default(false)
  restriction_status                                     String?                               @default("active")
  restriction_reason                                     String?
  restricted_at                                          DateTime?                             @db.Timestamptz(6)
  restricted_by                                          String?                               @db.Uuid
  restriction_lifted_at                                  DateTime?                             @db.Timestamptz(6)
  legacy_firestore_id                                    String?                               @unique(map: "idx_businesses_legacy_firestore_id", where: raw("(legacy_firestore_id IS NOT NULL)"))
  is_deleted                                             Boolean                               @default(false)
  deleted_at                                             DateTime?                             @db.Timestamptz(6)
  deleted_by_id                                          String?                               @db.Uuid
  deleted_by_type                                        String?
  recovery_deadline_at                                   DateTime?                             @db.Timestamptz(6)
  deletion_reason                                        String?
  subscription_family                                    String?
  subscription_business_type                             String?
  subscription_amount                                    Decimal?                              @db.Decimal(12, 2)
  subscription_receipt_url                               String?
  subscription_status                                    String?
  subscription_review_status                             String?
  subscription_synced_at                                 DateTime?                             @db.Timestamptz(6)
  settings                                               Json?                                 @default("{}")
  apartment_booking_payments                             apartment_booking_payments[]
  apartment_bookings                                     apartment_bookings[]
  apartment_units                                        apartment_units[]
  apartments                                             apartments[]
  attendance                                             attendance[]
  bakery_resupplies                                      bakery_resupplies[]
  bar_invoices                                           bar_invoices[]
  bar_tables                                             bar_tables[]
  business_members                                       business_members[]
  profiles_businesses_owner_idToprofiles                 profiles?                             @relation("businesses_owner_idToprofiles", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                                              customers[]
  devices                                                devices[]
  distributor_sales                                      distributor_sales[]
  distributors                                           distributors[]
  drink_orders                                           drink_orders[]
  expenses                                               expenses[]
  hotel_folio_charges                                    hotel_folio_charges[]
  hotel_guests                                           hotel_guests[]
  hotel_reservations                                     hotel_reservations[]
  hotel_rooms                                            hotel_rooms[]
  hotel_service_orders                                   hotel_service_orders[]
  inventory                                              inventory[]
  inventory_alert_acks                                   inventory_alert_acks[]
  inventory_batches                                      inventory_batches[]
  inventory_history                                      inventory_history[]
  invoices                                               invoices[]
  notifications                                          notifications[]
  payment_transactions                                   payment_transactions[]
  petroleum_admin_cash_submissions                       petroleum_admin_cash_submissions[]
  petroleum_bank_deposits                                petroleum_bank_deposits[]
  petroleum_cash_entries                                 petroleum_cash_entries[]
  petroleum_cash_total_correction_log                    petroleum_cash_total_correction_log[]
  petroleum_cash_total_corrections                       petroleum_cash_total_corrections?
  pharmacy_audit_log                                     pharmacy_audit_log[]
  pharmacy_patients                                      pharmacy_patients[]
  pharmacy_prescriptions                                 pharmacy_prescriptions[]
  pharmacy_treatments                                    pharmacy_treatments[]
  procurements                                           procurements[]
  profiles_profiles_current_business_idTobusinesses      profiles[]                            @relation("profiles_current_business_idTobusinesses")
  profiles_profiles_subscription_business_idTobusinesses profiles[]                            @relation("profiles_subscription_business_idTobusinesses")
  pump_daily_uploads                                     pump_daily_uploads[]
  pump_upload_adjustments                                pump_upload_adjustments[]
  pumps                                                  pumps[]
  realtime_subscriptions                                 realtime_subscriptions[]
  reorders                                               reorders[]
  restaurant_menu_items                                  restaurant_menu_items[]
  restaurant_orders                                      restaurant_orders[]
  restaurant_reservations                                restaurant_reservations[]
  restaurant_staff                                       restaurant_staff[]
  restaurant_tables                                      restaurant_tables[]
  restaurant_waste                                       restaurant_waste[]
  returns                                                returns[]
  sale_deletions                                         sale_deletions[]
  sales                                                  sales[]
  stores                                                 stores[]
  subscription_events                                    subscription_events[]
  subscription_requests                                  subscription_requests[]
  subscription_transactions                              subscription_transactions[]
  sync_audit_log                                         sync_audit_log[]
  workers                                                workers[]
  administrative_subscriptions                           AdministrativeSubscription[]
  administrative_usage                                   AdministrativeUsage?

  teams               Team[]
  tasks               Task[]
  clients             Client[]
  obligations         Obligation[]
  obligation_expenses ObligationExpense[]
  folders             Folder[]
  documents           Document[]
  archives            Archive[]
  activities          Activity[]

  @@index([is_active], map: "idx_businesses_active")
  @@index([owner_id], map: "idx_businesses_owner")
  @@index([is_restricted, restriction_status], map: "idx_businesses_restriction")
}

model company_expenses {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title        String
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  category     String?
  description  String?
  expense_date DateTime? @default(now()) @db.Timestamptz(6)
  receipt_url  String?
  created_by   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([expense_date(sort: Desc)], map: "idx_company_expenses_date")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id         String     @db.Uuid
  name                String
  email               String?
  phone               String?
  address             String?
  city                String?
  state               String?
  loyalty_points      Int?       @default(0)
  total_purchases     Decimal?   @default(0) @db.Decimal(12, 2)
  total_spent         Decimal?   @default(0) @db.Decimal(12, 2)
  is_active           Boolean?   @default(true)
  created_at          DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?  @default(now()) @db.Timestamptz(6)
  legacy_firestore_id String?
  total_transactions  Int        @default(0)
  average_order_value Decimal    @default(0) @db.Decimal(12, 2)
  first_purchase_date DateTime?  @db.Timestamptz(6)
  last_purchase_date  DateTime?  @db.Timestamptz(6)
  notes               String?
  metadata            Json       @default("{}")
  businesses          businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([business_id, legacy_firestore_id], map: "idx_customers_business_legacy_firestore_id", where: raw("(legacy_firestore_id IS NOT NULL)"))
  @@index([business_id], map: "idx_customers_business")
  @@index([phone], map: "idx_customers_phone")
}

model device_tokens {
  device_id   String    @id @db.VarChar(255)
  user_id     String    @db.Uuid
  platform    String?   @default("mobile") @db.VarChar(50)
  device_name String?   @db.VarChar(255)
  last_seen   DateTime? @default(now()) @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  profiles    profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_device_tokens_user_id")
}

model devices {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serial_number String      @unique
  business_id   String?     @db.Uuid
  name          String?
  last_seen     DateTime?   @db.Timestamptz(6)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  businesses    businesses? @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([serial_number], map: "idx_devices_serial")
}

model distributor_sales {
  id                    String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id           String       @db.Uuid
  sale_id               String?      @db.Uuid
  distributor_id        String       @db.Uuid
  distributor_name      String?
  product_id            String?      @db.Uuid
  product_name          String?
  quantity              Decimal      @db.Decimal(12, 2)
  unit_price            Decimal      @db.Decimal(12, 2)
  discount_percent      Decimal      @default(0) @db.Decimal(5, 2)
  discounted_unit_price Decimal      @db.Decimal(12, 2)
  total_amount          Decimal      @db.Decimal(12, 2)
  sales_rep_id          String?      @db.Uuid
  sales_rep_name        String?
  notes                 String?
  status                String       @default("completed")
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  legacy_firestore_id   String?
  businesses            businesses   @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  distributors          distributors @relation(fields: [distributor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales                 sales?       @relation(fields: [sale_id], references: [id], onUpdate: NoAction)

  @@index([business_id], map: "idx_distributor_sales_business_id")
  @@index([created_at(sort: Desc)], map: "idx_distributor_sales_created_at")
  @@index([distributor_id], map: "idx_distributor_sales_distributor_id")
  @@index([legacy_firestore_id], map: "idx_distributor_sales_legacy_fs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model distributors {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id         String              @db.Uuid
  name                String
  contact_person      String?
  phone               String?
  email               String?
  address             String?
  is_active           Boolean?            @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @default(now()) @db.Timestamptz(6)
  legacy_firestore_id String?
  notes               String?
  distributor_sales   distributor_sales[]
  businesses          businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id], map: "idx_distributors_business")
