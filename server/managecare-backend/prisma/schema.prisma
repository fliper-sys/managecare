  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  obligation Obligation @relation(fields: [obligation_id], references: [id], onDelete: Cascade)

  client Client? @relation(fields: [client_id], references: [id], onDelete: SetNull)

  worker workers? @relation(fields: [worker_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id])
  @@index([obligation_id])
  @@index([client_id])
  @@index([worker_id])
  @@index([date_incurred])
  @@map("obligation_expenses")
}

model Folder {
  id Int @id @default(autoincrement())

  business_id String @db.Uuid

  name String

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  documents Document[]
  archives  Archive[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id])
  @@map("folders")
}

model Document {
  id Int @id @default(autoincrement())

  business_id String @db.Uuid
  folder_id   Int
  client_id   Int?

  name String

  // Path/key in S3, MinIO, etc.
  storage_key String

  mime_type  String?
  size_bytes BigInt?

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  folder Folder @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  client Client? @relation(fields: [client_id], references: [id], onDelete: SetNull)

  archives Archive[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id])
  @@index([folder_id])
  @@index([client_id])
  @@map("documents")
}

model Archive {
  id Int @id @default(autoincrement())

  business_id String @db.Uuid

  folder_id   Int?
  document_id Int

  data   String?
  review String?

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  folder Folder? @relation(fields: [folder_id], references: [id], onDelete: SetNull)

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id])
  @@index([folder_id])
  @@index([document_id])
  @@map("archives")
}

model Activity {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  business_id        String @db.Uuid
  business_member_id String @db.Uuid

  action ActivityAction

  entity_type String
  entity_id   String?

  description String?

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  business_member business_members @relation(fields: [business_member_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([business_id])
  @@index([business_member_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("activities")
}
