# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Server-only Auth Admin API credentials for verified legacy-account linking.
# Never add SUPABASE_SERVICE_ROLE_KEY to Flutter, web, or mobile configuration.
SUPABASE_URL=https://your-supabase-host.example
SUPABASE_SERVICE_ROLE_KEY=

# Optional old signing key for validating already-issued app tokens during a
# JWT_SECRET rotation. Remove after the longest issued token has expired.
# JWT_SECRET_PREVIOUS=
